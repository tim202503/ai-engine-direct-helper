{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qualcomm/qai-appbuilder/CommunityApps/schema/app.schema.json",
  "title": "QAI AppBuilder Community App metadata",
  "description": "Single source of truth for a community app. Used to auto-discover the app, generate the gallery (index.html), the index table (README.md), and to validate contributions in CI. Fill this in and the app appears everywhere automatically — no hand-maintained lists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "version", "author", "description", "category", "run"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable display name."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Lowercase hyphenated id. Must match the app's folder name."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+.*$",
      "description": "Semantic version, e.g. 1.0.0."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "github": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["short"],
      "properties": {
        "short": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "One-line summary for the gallery card and index table."
        },
        "long": { "type": "string" }
      }
    },
    "category": {
      "type": "string",
      "enum": ["genai", "vision", "audio", "multimodal", "agent", "other"],
      "description": "Controlled vocabulary powering gallery filter tabs."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "license": { "type": "string" },
    "homepage": { "type": "string" },
    "source": {
      "type": "string",
      "description": "Where the app was submitted from — a Discussions thread or Issue URL. Helps reviewers trace provenance."
    },
    "screenshot": {
      "type": "string",
      "description": "Path (relative to the app folder) to the gallery thumbnail, 16:9 recommended."
    },
    "screenshots": {
      "type": "array",
      "items": { "type": "string" }
    },
    "demoVideo": { "type": "string" },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["llm", "asr", "tts", "vision", "diffusion", "embedding", "other"] },
          "runtime": { "type": "string", "enum": ["QNN", "SNPE", "ONNX", "other"] },
          "precision": { "type": "string" },
          "source": { "type": "string" },
          "sizeMB": { "type": "number" }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": {
          "type": "array",
          "items": { "type": "string", "enum": ["windows-arm64", "windows-x64", "linux-aarch64", "android"] }
        },
        "python": { "type": "string" },
        "qai_appbuilder": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "npu": { "type": "string" },
            "minRamGB": { "type": "number" }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "setup": { "type": "string" },
        "windows": { "type": "string" },
        "command": { "type": "string", "minLength": 1 },
        "entrypoint": { "type": "string" },
        "port": { "type": ["integer", "null"] }
      }
    },
    "official": {
      "type": "boolean",
      "description": "Always false for community submissions. Reserved for Qualcomm-curated apps in samples/apps/."
    },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
